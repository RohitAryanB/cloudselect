PORT=5000
MONGO_URI=mongodb://localhost:27017/cloudselect
JWT_SECRET=change-me

# ── AWS (EC2 control panel) ──────────────────────────────────────────
# Create an IAM user with ONLY the permissions in
# /deploy/aws-iam-policy.example.json — never use your root account keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Comma-separated list of regions the dashboard is allowed to touch.
# Leave unset to use the built-in default list.
AWS_ALLOWED_REGIONS=us-east-1,ap-south-1

# Safety limits — see backend/src/services/awsEc2Service.js
MAX_ACTIVE_INSTANCES=2
ALLOW_NON_FREE_TIER_LAUNCH=false
